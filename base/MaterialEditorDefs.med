	TYPE_STRING,	"green",			"Green",					"Green component expression.",				0
	TYPE_STRING,	"blue",				"Blue",						"Blue component expression.",				0
	TYPE_STRING,	"alpha",			"Alpha",					"Alpha component expression.",				0
