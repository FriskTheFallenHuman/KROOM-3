// ===========================================================================
//
//  MaterialEditorDefs.med
//
//  Schema for the Material Editor property grid.
//
//      materialprops         - top-level material attributes
//      stageprops            - attributes on a normal stage
//      specialmapstageprops  - attributes on a special map stage
//                              (bumpmap / diffusemap / specularmap)
//
//  Syntax for a single entry:
//
//      TYPE_<type>, "<dictname>", "<display name>", "<help text>"
//      TYPE_STRING, "<dictname>", "<display name>", "<help text>", <quotes>
//
//  Types:
//      TYPE_GROUP   - tree group header
//      TYPE_BOOL    - checkbox; writes the keyword alone when true
//      TYPE_STRING  - text field; when <quotes> is 1, wraps the value in
//                     double quotes on write
//      TYPE_FLOAT   - floating point field
//      TYPE_INT     - integer field
//
//  Every <dictname> below matches a keyword the material parser accepts.
//  See Material.cpp / MaterialDoc.cpp for how each value is read and
//  regenerated.
//
// ===========================================================================

materialprops
{
	TYPE_GROUP,		"mat_info",			"Material Info",			"Basic material information."

	TYPE_STRING,	"description",		"Description",				"Human-readable description of the material.",					1
	TYPE_STRING,	"qer_editorimage",	"Editor Image",				"Image used to represent this material in the editor.",			0

	TYPE_GROUP,		"mat_appearance",	"Appearance",				"Visual and rendering attributes."

	TYPE_BOOL,		"twoSided",			"Two Sided",				"Render both faces of the surface."
	TYPE_BOOL,		"backSided",		"Back Sided",				"Render only the back face."
	TYPE_BOOL,		"translucent",		"Translucent",				"Render as a translucent surface."
	TYPE_BOOL,		"forceOpaque",		"Force Opaque",				"Render as opaque even if the blend mode is translucent."
