	TYPE_BOOL,		"privatePolygonOffset","Private Polygon Offset","Apply stage-local polygon offset (defaults to 1; edit text for a custom value)."
	TYPE_STRING,	"if",				"Conditional",				"Conditional expression; the stage is only drawn if the expression is nonzero.",	0
}

