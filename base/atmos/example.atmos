// Procedural sky. Select it from a map with the worldspawn key:  "atmos" "atmos/example"
// Opt a map out with:  "atmos" "none"   (or "noAtmos" "1")
// Every value below can be overridden at runtime with the matching r_atmos* cvar,
// e.g.  r_atmosCloudOpacity 0.4,  r_atmosSkyMaterial none.  r_atmos 2 applies the
// built in defaults + cvars to maps that have no atmos decl at all.

atmos atmos/example
{
	skyMaterial		textures/skies/mars1		// 2D equirect (top half = visible hemisphere) or a cube material; remove for a plain gradient
	skyTint			1 1 1
	zenithColor		0.16 0.28 0.48				// gradient colors, used when there is no skyMaterial
	horizonColor	0.55 0.62 0.72
	intensity		1.0							// linear HDR multiplier
	grade			1.0							// S-curve grade strength, 0 = off
	portalSky		behind						// behind | replace | off

	clouds
	{
		enabled		1
		heightMin	2600						// units ABOVE THE EYE, so the sky room of a portal sky works too
		heightMax	7600
		scale		0.00021
		coverage	0.30						// lower = denser
		density		0.5
		opacity		0.78
		seed		12000
		color		auto						// auto = average of the sky material
		wind		55 -18						// units per second
		volume		0.65
	}

	fog
	{
		enabled		1
		color		auto
		opacity		0.36
		height		0.30
		power		1.15
	}
}
