textures/decals/new/bulletglass
{
	DECAL_MACRO
	translucent
	nonSolid
	noimpact
	twoSided
	noShadows
	polygonOffset
	
	qer_EditorImage	textures/decals/new/bulletglass.tga
	
	{
	 	blend	add
		map	 textures/decals/bulletglass1.tga
		vertexColor
	}
}

textures/decals/new/bpglass
{
	DECAL_MACRO
	translucent
	nonsolid
	noimpact
	twosided
	noshadows
	polygonOffset
	qer_editorimage	textures/decals/bpglass.tga
	
	{
	 	blend	add 
		map	 textures/decals/bpglass.tga
		vertexColor
		rgba .4 * decalFade[ DecalLife ]
	}
}


textures/decals/new/nailgun_burn
{
	qer_editorimage textures/decals/new/nailgun_burn1.tga

	DECAL_MACRO
	{       
	   	blend		gl_zero, gl_one_minus_src_color
		map			textures/decals/new/explosion_impact2.tga
		clamp		// we don't want it to tile if the projection extends past the bounds
		rgba		decalFade[ DecalLife ]
		vertexColor	// oblique projections will be slightly faded down
	}

	{
	   	blend	add  
		map		textures/decals/new/nailgun_burn2.tga
		rgba	nailgunburn[ DecalLife ]

		vertexColor	// oblique projections will be slightly faded down
	} 
}

