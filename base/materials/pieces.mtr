
//-----------------------------------------------------------------------

textures/particles/pieces/waveline1
{
	qer_editorimage textures/particles/pieces/waveline1.tga
	translucent
	twoSided
	noShadows
	{
		blend add
		map textures/particles/pieces/waveline1.tga
		vertexColor
		scroll time * 2, 0 
	}
}

textures/particles/pieces/waveline1b
{
	qer_editorimage textures/particles/pieces/waveline1.tga
	translucent
	twoSided
	noShadows
	{
		blend add
		map textures/particles/pieces/waveline1.tga
		vertexColor
		scroll time * 1.23, 0 
	}
}

