gfx/effects/particels_shapes/glass_chunks2
{
	
	noSelfShadow
	noshadows
	twosided
	translucent
//	materialType glass
	forceoverlays
//	sort decal
	
/*	{
		blend  blend
		map    textures/particles/pieces/glass_chunks.tga
		vertexColor
	}
*/
	{	
		maskcolor				
	    map	makealpha(textures/particles/pieces/glass_chunks2.tga)
	}

	{
	    blend GL_DST_ALPHA, gl_one
	    maskalpha
//      cubeMap		gfx/env/gen2
		cubeMap		gfx/env/medic
        texgen		reflect
		red   Parm0
		green Parm1
		blue  Parm2
	}
}





