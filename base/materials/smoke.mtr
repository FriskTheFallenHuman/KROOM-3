textures/particles/smoke/smoke_dark
{
	noshadows
	translucent
	{
		blend  blend
		map    textures/particles/smoke/smoke_dark.tga
		vertexColor
	}
}

textures/particles/smoke/smoke_dark2
{
	noshadows
	translucent
	
	{
		maskcolor				
	    map	makealpha(textures/particles/smoke/smoke_dark_mask.tga)
	    vertexColor
	}
	{
	    blend GL_DST_ALPHA, gl_one
		maskAlpha
		map    textures/particles/smoke/smoke_dark.tga
		vertexColor
	}
	
}
