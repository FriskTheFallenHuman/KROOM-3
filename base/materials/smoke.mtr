textures/particles/smoke/blacksmokepuff
{
	qer_editorimage textures/particles/smoke/blacksmokepuff.tga
	noShadows
	{
		blend		gl_zero, gl_one_minus_src_color
		map textures/particles/smoke/blacksmokepuff.tga
		vertexColor
	}
}


