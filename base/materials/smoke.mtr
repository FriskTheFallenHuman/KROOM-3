//-----------------------------------------------------------

textures/particles/smoke/cloud_add_snd
{
	qer_editorimage	textures/particles/smoke/cloud_add.tga
	noShadows
	nonSolid
	translucent
	twoSided
	{
		blend add
		map textures/particles/smoke/cloud_add.tga
		red 		sound * Parm0
 		green 		sound * Parm1
		blue 		sound * Parm2
	}	
}

textures/particles/smoke/cloud_add
{
	qer_editorimage	textures/particles/smoke/cloud_add.tga
	noShadows
	nonSolid
	translucent
	twoSided
	{
		blend add
		map textures/particles/smoke/cloud_add.tga
		vertexColor
	}	
}

textures/particles/smoke/cloud_alpha3
{
	noshadows
	translucent
	{
		blend  blend
		map    textures/particles/smoke/cloud_alpha3.tga
		vertexColor
	}
}

textures/particles/smoke/cloud_alpha4
{
	noSelfShadow
	noshadows
	translucent
	discrete
	twosided
	nonsolid
	noimpact
	{
		blend  diffusemap
		map    textures/particles/smoke/cloud_alpha3.tga
		vertexColor
	}
}

//--------------------------------------
//		new material for concrete smoke
//--------------------------------------

textures/particles/smoke/dirt_cloud
{
	noshadows
	translucent
	{
		blend  blend
		map    textures/particles/smoke/cloud_alpha3.tga
		vertexColor
	}
	{
		blend  blend
		map    textures/particles/pieces/dirt2.tga
		vertexColor
	}
}

