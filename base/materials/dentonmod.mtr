
//---------------------------------------------------------------
// MAterial for Laser
//---------------------------------------------------------------

textures/sfx/beam_colored
 {
	translucent
	deform tube
	noSelfShadow
	noshadows

	qer_editorimage textures/sfx/beam_colored.tga

	{
		blend add
		map	textures/sfx/beam_colored.tga
		forcehighquality
	}
}


