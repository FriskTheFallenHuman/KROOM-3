//---------------------------------------------------------------
// light for lasersight glow.
//---------------------------------------------------------------


lights/laserglow
{	
	noShadows
	{
		forceHighQuality
		map	lights/falloff_exp1.tga
		red		0.6 * guiLightTable[ time ]
		green	0.1 * guiLightTable[ time ]
		blue	0.1 * guiLightTable[ time ]
		zeroClamp
	}
}

//---------------------------------------------------------------
// MAterial for red flare used for lasersight glow
//---------------------------------------------------------------

material textures/particles/flare2_red {
	translucent
	//deform sprite
	{
		blend			add
		map				textures/particles/flare_red.tga
		vertexcolor
	}
}

//-------------------------------------------------
// Blood Pool Overlays
//-------------------------------------------------

textures/decals/test1
{

	qer_editorimage textures/decals/test1.tga
	DECAL_MACRO

	{
		if ( parm7 == 0 )
		blend gl_dst_color,gl_zero
		map	textures/decals/test1.tga
		clamp
	}
 }


