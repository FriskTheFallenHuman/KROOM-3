//---------------------------------------------------------------
// MAterials for flashlight.
//---------------------------------------------------------------

textures/particles/beam1 {
	translucent
	deform tube
	noSelfShadow
	noShadows
	//sort nearest   // Test
	{
		maskcolor
		map makealpha(textures/particles/beam1.tga)
		//	scroll	time * 3 , time * 0	
		forcehighquality
	
	
	}
	{
		blend gl_dst_alpha, gl_one
	        maskalpha
		map models/items/flashlight/dust
		scale	 4 , 4
		rotate time * -.02
		scroll	time * .001 , time * .001
	}
}

//---------------------------------------------------------------
// MAterials for muzzleflashes
//---------------------------------------------------------------

textures/particles/boomboom_mflash

{
    noselfShadow
    noshadows	
	translucent
	discrete
	nonsolid
	noimpact
	
	sort nearest // for muzzleflashes 
	{ 
      
      	blend add
	    map	textures/particles/boomboom
		vertexcolor


						
	}

}


textures/particles/boomboom2_mflash
{
    noselfShadow
    noshadows	
