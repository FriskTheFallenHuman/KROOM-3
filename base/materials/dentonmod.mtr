//-------------------------------------------------
// New Material based decals
//-------------------------------------------------

// Concrete Wound

textures/decals/new/concrete
{

	qer_editorimage textures/decals/new/concrete.tga
	DECAL_MACRO

	{
		if ( parm7 == 0 )
		blend gl_dst_color,gl_zero
		map	textures/decals/new/concrete.tga
		clamp
	}

 }

// Metal Wound

textures/decals/new/metal
{

	qer_editorimage textures/decals/new/metal.tga
	DECAL_MACRO

	decalInfo 10 1 ( 1 1 1 1 ) ( 0 0 0 0 )
	{       
      	blend	gl_zero, gl_one_minus_src_color
		map		textures/decals/new/metal.tga

		clamp			// we don't want it to tile if the projection extends past the bounds
		vertexColor		// oblique projections will be slightly faded down
	}

 }

