//
// Default materials
//
_emptyName
{
	description	"Empty-name editor texture"
	qer_editorimage	textures/_emptyname.png
	diffusemap	textures/_emptyname.png
	bumpmap	textures/_emptyname_local.png
	specularmap	textures/_emptyname_s.png
}

textures/default
{
	description	"Default editor texture"
	qer_editorimage	textures/_emptyname.png
	diffusemap	textures/_emptyname.png
	bumpmap	textures/_emptyname_local.png
	specularmap	textures/_emptyname_s.png
}

//
// Editor Icons
//
light_icon
{
    translucent
    noselfshadow
    noshadows
    twosided

    {
        blend gl_src_alpha, gl_one_minus_src_alpha
        map textures/editoricons/light.png
    }
}

