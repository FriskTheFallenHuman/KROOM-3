	//"damage"					"150"				//Do not include damage, push etc here
	//"push"					"8000"	//"1000"    // since def_splash_damage is going to handle it.
	"damage"					"20"

	"mtr_wound"					"textures/decals/new/rocketburn"
 
	"mtr_wound_flesh"			"textures/decals/plasmahurt01"
	"size_wound_flesh"			"15"
	"size_wound"				"300"
	//"mtr_splat_flesh"			""
	"gib"						"1"
	"smoke_wound_flesh"			"burstysquirt.prt" //"bloodwound.prt"
	
	"mtr_splatSelf_flesh"	"textures/decals/test1"
	//"mtr_splatSelf_flesh"	"textures/decals/test3"
	"size_splatSelf_flesh"	"25"
}

entityDef damage_rocketSplash {
	"damage"					"150"//150
	"radius"					"175" //changed by Tim 6-22-04 from 132
	"knockback"					"180" // 80
	"push"						"60000" // 10000
	"attackerDamageScale"		"0.2"
	"attackerPushScale"			"0.4"
	"gib"						"1"
