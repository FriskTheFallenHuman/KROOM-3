	"blob_size"			"400"
	"blob_offset_x"		"400"

	"knockback"			"30"  // 15 34
	
	"gib"				"1"
	"kick_time"			"400"
	"kick_amplitude"	"1"

	"dv_time"			"100"
	
	"smoke_wound"				"smokesparks.prt"	// Default Smoke 
	"smoke_wound_flesh"			"burstysquirt.prt"
	"smoke_wound_cardboard"		"smokecardboard.prt"
	"smoke_wound_wood"			"smokewood.prt"	
	"smoke_wound_stone"			"smokestone.prt" 
	"smoke_wound_glass"			"smokeglass.prt"
	"smoke_wound_plastic"		"smokeplastic.prt"
	"smoke_wound_surftype11"	"smokesand.prt"		// surftype11 is sand 
	"smoke_wound_surftype10"	"smokeconcrete.prt"	// smoke for Concrete 
	//"smoke_wound_ricochet"	"smokesparks.prt"

	"mtr_wound"					"textures/decals/ballburn01"// Default material
	"mtr_wound_flesh"			"textures/decals/hurt02"
	"mtr_wound_glass"			"textures/decals/new/bulletglass"
	"mtr_wound_wood"			"textures/new/decals/wood/shot3"
	"mtr_wound_cardboard"		"textures/decals/new/concrete" 
	"mtr_wound_plastic"			"textures/decals/new/concrete" 
	//"mtr_wound_surftype10"	"textures/decals/new/concrete"
	"mtr_wound_surftype10"		"textures/new/decals/concrete/shot1"	//surftype10 is concrete
	"mtr_wound_surftype11"		"textures/decals/new/concrete"			//surftype11 is sand

	"size_wound"				"5"		
	"size_wound_flesh"			"8"		
	"size_wound_wood"			"7"		
	"size_wound_cardboard"		"10"		// cardboard and paper decal size
	"size_wound_plastic"		"7"			// plastic decal size
	"size_wound_surftype10"		"4"//"10"	// concrete
	"size_wound_surftype11"		"12"		// sand

	"mtr_splat_flesh"			"textures/decals/dsplat2"
	"mtr_splat_flesh3"			"textures/decals/dsplat7"
	"mtr_splat_flesh4"			"textures/decals/dsplat11"

	"mtr_bloodPool_flesh"		"textures/decals/new_splat"

	"size_bloodPool_flesh"		"72"
	"bloodpool_below_origin"	"1"				// When this flag is set, bloodPool is created below origin of 
												// colliding entity, as opposed to bloodPool below colling point.

	"mtr_splatSelf_flesh"		"textures/decals/test2"
	"mtr_splatSelf_flesh2"		"textures/decals/test3"
	"mtr_splatSelf_flesh3"		"textures/decals/test4"

	"size_splatSelf_flesh"		"30"

	"snd_flesh"					"shotgun_impact_flesh"
	"snd_metal"					"shotgun_impact_metal"		//default sound
	"snd_stone"					"bullet_impact_stone"
	"snd_wood"					"bullet_impact_wood"
	"snd_cardboard"				"bullet_impact_cardboard"
	"snd_glass"					"bullet_impact_glass"
	"snd_liquid"				"bullet_impact_liquid"
	"snd_ricochet"				"bullet_ricochet"
	"snd_plastic"				"bullet_impact_plastic"
	"snd_surftype10"			"shotgun_impact_concrete"
	"snd_surftype11"			"bullet_impact_sand"
}

entityDef debris_shotgunbrass {
	"spawnclass"				"idDebris"
	"mins"						"-1 -1 -1"
	"maxs"						"1 1 1"

	"model" 					"models/weapons/shell1/sshell_bigger.lwo"

	"health"					"0"					// amount of damage projectile can take if damaged (0 means it can't be destroyed)
	"velocity"					"0 40 70" //60 30 10			// how fast the projectile leaves the gun (or distance if fuse is 0)
	"angular_velocity"			"0 0 0"				// how the projectile is rotating when it leaves the gun
	"thrust"					"0"					// the rate of acceleration (always in the direction of the projectiles model)
	"thrust_start"				"0"					// when to start accelerating
	"thrust_end"				"0"					// when to stop accelerating
	"linear_friction"			"0.6"				// "air" friction
	"angular_friction"			"0.4"
	"contact_friction"			"0.1"
	"bounce"					"0.3"//.5				// how much speed a projectile retains when it bounces off of objects (coefficient of restitution).  0 means no bounce.
	"mass"						"10" 
	"gravity"					"666"				// how much gravity affects the trajectory.  gravity direction is same as the entity that fired it.
	"fuse"						"3"					// how long before the projectile is removed or self-detonates.  Use 0 for beam weapons (velocity == distance).

	"detonate_on_fuse"			"1"					// whether projectile should detonate when it's fuse runs out
	"detonate_on_death"			"0"					// whether projectile should detonate when it's "killed" (health runs out)
	"detonate_on_world"			"0"					// whether projectile should detonate when it hits an obstacle
	"detonate_on_actor"			"0"					// whether projectile should detonate when it hits a character in the game
	"snd_bounce"				"casings_shotgun"
	//"snd_rest"					"casings_shotgun_rest"
}

