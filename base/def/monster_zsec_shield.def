	}
	anim stepoutleft_in				models/md5/monsters/zombies/zsec_shield/shield_wallrotleft_D.md5anim
	anim stepoutleft_wait			models/md5/monsters/zombies/zsec_shield/shield_wallrotleft_A.md5anim


