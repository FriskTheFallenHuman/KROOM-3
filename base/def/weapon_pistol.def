entityDef projectile_bullet_pistol {
	"spawnclass"				"idProjectile"
	"mins"						"-1 -1 -1"
	"maxs"						"1 1 1"
	"cone"						"3"
	"scale"						"0.1"
	"noshadows"					"1"
	
	"tracers"					"1" //If this flag and launchFromBarrel flag are set to 1, the new tracer logic is enabled
	"tracer_speed"				"5800" 

	//"model_tracer"			"tracer.prt"
	"beam_skin"					"textures/particles/tracer1_nodeform"
	"beam_length"				"170" //220, 170
	
	"def_damage"				"damage_bullet_pistol"

	"launchFromBarrel"			"1"
	"health"					"0"
	"velocity"					"7200 0 0"	//7200,  .38 Special 600 fps.  Source: Petzal, David E. "How fast is a speeding bullet." Field and Stream. 97 (1992): 23
	"angular_velocity"			"0 0 0"
	"thrust"					"0"
	"thrust_start"				"0"
	"thrust_end"				"0"
	"linear_friction"			"0"
	"angular_friction"			"0"
	"contact_friction"			"0"
	"bounce"					"0.6"
	"mass"						"3" // 4, 2
	"gravity"					"0"
	"fuse"						"4"//4

	"detonate_on_fuse"			"0"
	"detonate_on_death"			"0"
	"detonate_on_world"			"1"
	"detonate_on_actor"			"1"
	
	"impact_damage_effect"		"1"
	"impact_gib"				"1"

	"model_smokespark"			"bulletsparks.prt"   //"bulletsmokeandspark.prt"
	"model_ricochet"			"bulletsparks.prt"

	"smoke_fly"					""
	
	"mtr_light_shader"			""
