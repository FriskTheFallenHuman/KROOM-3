
/***********************************************************************

Simple Vehicle

***********************************************************************/

export fred {
	options -prefix LOCUST_ -align ALL -keep Eyes -parent Eyes Body -keep SteeringWheel -parent SteeringWheel Body
	mesh	models/vehicles/buggy/buggy.mb 
	anim	models/vehicles/buggy/buggy.mb
}

model env_simplebuggy {
	mesh							models/md5/vehicles/buggy/buggy.md5mesh
	anim af_pose					models/md5/vehicles/buggy/buggy.md5anim
}

entityDef env_simplebuggy_red {
	"editor_var specialWheels"		"0"
	"editor_var wheelPrt"			"wheel particle (string)"
	"editor_var wheelPrtOffset"		"wheel particle offset (vector)"

	"inherit"						"env_simplebuggy"
	"scriptobject"					"vehicle_buggy_turbo" //"vehicle"
	"skin"							"skins/buggy_red"
	//"specialWheels"				"0"
	"wheelPrt"						"vehicle_trail.prt"
	"wheelPrtOffset"				"0 0 10"
	"turbo_time"					"0.5"
	"turbo_power"					"60"
	"health"						"900"

	"def_projectile"				""
	"fire_rate"						"3"
	"fx_fire"						""

	//settings
	"vehicleVelocity"				"1500"
	"vehicleForce"					"70000"
	"vehicleSuspensionUp"			"32"
	"vehicleSuspensionDown"			"20"
	"vehicleSuspensionKCompress"	"1000"
	"vehicleSuspensionDamping"		"400"
	"vehicleTireFriction"			"0.8"

	"snd_fire"						"buggy_turbo"

	//hud & cursor
	//"hudWeaponEvent"				"setup_buggy_turbo"
	//"hudHealthEvent"				"health_mode_buggy_red"
	//"cursorEvent"					"hideCursor"
}

