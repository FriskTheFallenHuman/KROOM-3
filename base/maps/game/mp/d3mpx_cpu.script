namespace map_d3mpx_cpu {
	void opentrap() {
		sys.trigger( $target_entity_fadein_1 );
		sys.trigger( $target_entity_fadein_redlights_in );
		sys.trigger( $target_entity_fadein_whites_out );
		sys.trigger( $target_entity_backlights_down );
		sys.trigger( $target_entity_backyellow_down );
		sys.trigger( $target_entity_tunnel_down );
		sys.trigger( $target_entity_toplights_down );
		sys.trigger( $speaker_powerdown5 );
		sys.trigger( $func_portal_2 );
		sys.trigger( $speaker_trapdoors_open );
		sys.trigger( $speaker_trapdoors_open2 );
		$func_static_pivot_1.rotateDownTo ( 0 , -75);
		$func_static_pivot_2.rotateDownTo ( 2 , -75);
		$func_static_pivot_3.rotateUpTo ( 0 , 75);	
		$func_static_pivot_4.rotateUpTo ( 2 , 75);

		sys.trigger( $cspeaker_2 );
		sys.trigger( $cfunc_static_170 );
		sys.trigger( $cfunc_static_169 );	
		sys.trigger( $cfunc_static_158 );
		sys.trigger( $cfunc_static_171 );
		sys.trigger( $ctrigger_hurt_1 );
		sys.trigger( $ctrigger_hurt_2 );
		sys.trigger( $ctrigger_hurt_3 );
		sys.trigger( $ctrigger_hurt_4 );

		sys.wait( 2 );
		
		sys.trigger( $target_entity_backlights_up );
		sys.trigger( $target_entity_backyellow_up );
		sys.trigger( $target_entity_tunnel_up );
		sys.trigger( $target_entity_toplights_up );

		sys.wait( 4 );
		
		$func_static_pivot_1.rotateUpTo ( 0 , 0);
		$func_static_pivot_2.rotateUpTo ( 2 , 0);
		$func_static_pivot_3.rotateDownTo ( 0 , 0);	
		$func_static_pivot_4.rotateDownTo ( 2 , 0);
		sys.trigger( $target_entity_fadein_2 );
		sys.trigger( $target_entity_fadein_3 );
		sys.trigger( $target_entity_fadein_redlights_out );
		sys.trigger( $target_entity_fadein_whites_in );
		sys.trigger( $speaker_powerup1 );
		sys.trigger( $speaker_powerup2 );
		sys.trigger( $speaker_powerup3 );
		sys.trigger( $speaker_powerup4 );
		sys.trigger( $speaker_powerup5 );

		sys.wait( .25 );

		sys.trigger( $speaker_trapdoors_close );	
		sys.trigger( $speaker_trapdoors_close2 );

		sys.wait( .25 );

		sys.trigger( $func_portal_2 );

		sys.wait( .5 );

		sys.trigger( $cfunc_static_170 );
		sys.trigger( $cfunc_static_169 );	
		sys.trigger( $cfunc_static_158 );
		sys.trigger( $cfunc_static_171 );
		sys.trigger( $ctrigger_hurt_1 );
		sys.trigger( $ctrigger_hurt_2 );
		sys.trigger( $ctrigger_hurt_3 );
		sys.trigger( $ctrigger_hurt_4 );
		$cspeaker_2.stopSound(SND_CHANNEL_ANY, 1);
	}

	void main() {
		$func_static_trapdoor_1.bind( $func_static_pivot_1);
		$func_static_trapdoor_2.bind( $func_static_pivot_2);
		$func_static_trapdoor_3.bind( $func_static_pivot_3);
		$func_static_trapdoor_4.bind( $func_static_pivot_4);
	}
}