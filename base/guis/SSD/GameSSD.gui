	windowDef IntroScreen {
		rect 0,0,640,480
		visible 1

		windowDef InsertText
		{
			rect	0,351,640,29
			text	"#str_00100108"
			font	"fonts/micro"
			textscale	0.4
			forecolor	1,1,1,0.749
			visible	1
			textalign	1
		}
		windowDef CreditText {
			rect	0,371,640,29
			text	"#str_00100097"
			font	"fonts/micro"
			textscale	0.4
			forecolor	1,1,1,0.349
			visible	1
			textalign	1
		}
		windowDef GameTitle {
			rect	58,46,532,202

			//text	"Space Station Defender"
			//textscale 1.5
			//textalign 1
			background "guis/assets/arcade/martianbuddy_logo.tga"

			onTime 0 {
				transition "forecolor" "1 1 1 .9" "1 1 1 .4" "800" ;
			}

			onTime 800 {
				transition "forecolor" "1 1 1 .4" "1 1 1 .9" "200" ;
			}
			onTime 1000 {
				resetTime "0" ;
			}
		}


		windowDef StartButton
		{
			rect	65,249,505,96
			visible	0
			//background	"guis/assets/teleporter/button1"
			background "guis/assets/arcade/arcade_coincontinue_button.tga"
			matcolor	0.6,0,0,0.4

			onTime 0 {
				transition "matcolor" "0 0.6 0 1" "0 0.6 0 0.4" "800" ;
			}

			onTime 800 {
				transition "matcolor" "0 0.6 0 0.4" "0 0.6 0 1" "200" ;
			}

			onTime 1000 {
				resetTime "0" ;
			}

			onAction {
				set	"cmd"	"play arcade_startbeep" ;
				resetTime "fnStartGame"	"0";
			}

			windowDef TextButton
			{
				rect	0,10,505,96
				text	"#str_00100110"
				font	"fonts/bank"
				textscale	1
				forecolor	1,1,1,0.8
				visible	1
				textalign	1
			}
		}

		windowDef InsertCredit {

			rect	65,249,505,96
			visible	1
			//background	"guis/assets/teleporter/button1"
			background "guis/assets/arcade/arcade_coincontinue_button.tga"
			matcolor	0.6,0,0,1


			onAction {
				if("desktop::credits" == 3) {
					set	"cmd"	"play arcade_startgame" ;
					set	"desktop::credits"	4;
					set "InsertCredit::visible" "0";
					set "StartButton::visible" "1";
				}
				if("desktop::credits" == 2) {
					set	"cmd"	"play arcade_insertcoin" ;
					set	"desktop::credits"	3;
				}
				if("desktop::credits" == 1) {
					set	"cmd"	"play arcade_insertcoin" ;
					set	"desktop::credits"	2;
				}
				if("desktop::credits" == 0) {
					set	"cmd"	"play arcade_insertcoin" ;
					set	"desktop::credits"	1;
				}
			}

			windowDef TextButton
			{
				rect	0,10,505,96

				text	"#str_00100111"
				font	"fonts/bank"
				textscale	1
				forecolor	1,1,1,0.8
				visible	1
				textalign	1
			}
		}
	}

	windowDef LevelIntroScreen {

		noTime 1

		rect 0,-480,640,480
		visible 1

		windowDef LevelText {
			rect		0,30, 640, 200
			text		"#str_00100127"
			textscale	3
			textalign	1
		}
		windowDef LevelNumber {
			rect		0,150, 640, 200
			text		"gui::nextLevel"
			textscale	3
			textalign	1
		}
		windowDef TMinus {
			rect		0, 300, 640, 200
			text		"#str_00100128"
			textscale	1
			textalign	1
		}
		windowDef TMinusCount {
			rect		0, 350, 640, 200
			text		"5"
			forecolor	.6, 0, 0, 1
			textscale	1
			textalign	1
		}

		onTime 0 {
			set		"TMinusCount::text"	"5";
		}
		onTime 1000 {
			set		"TMinusCount::text"	"4";
		}
		onTime 2000 {
			set		"TMinusCount::text"	"3";
		}
		onTime 3000 {
			set		"TMinusCount::text"	"2";
		}
		onTime 4000 {
			set		"TMinusCount::text"	"1";
		}
		onTime 5000 {
			set		"TMinusCount::text"	"0";
			resetTime "fnBeginLevel" "0";
		}
	}

