windowDef Desktop {
	rect	0,0,640,480
	nocursor 0
	//nosave	1

	float	"credits"			0

	onEvent {
		if("desktop::credits" == 0) {
			set "CreditText::text" "#str_00100097";
		}
		if("desktop::credits" == 1) {
			set "CreditText::text" "#str_00100098";
		}
		if("desktop::credits" == 2) {
			set "CreditText::text" "#str_00100099";
		}
		if("desktop::credits" == 3) {
			set "CreditText::text" "#str_00100100";
		}
		if("desktop::credits" == 4) {
			set "CreditText::text" "#str_00100101";
		}

	}

	onNamedEvent playerDamage {
		resetTime "fnShackScreen" "0" ;

	}

	onNamedEvent levelComplete {
		resetTime "fnLevelComplete" "0" ;
	}

	onNamedEvent gameComplete {
		resetTime "fnGameComplete" "0" ;
	}

	onNamedEvent gameOver {
		resetTime "fnGameOver" "0" ;
	}

	onNamedEvent startSuperBlaster {
		set			"SuperBlaster::visible"	"1";
	}

	onNamedEvent stopSuperBlaster {
		set			"SuperBlaster::visible"	"0";
	}

	windowDef mainbackground {
		rect	0,0,640,480
		visible	1

		backcolor   0, 0, 0, 1
		matcolor	1,1,1,.8

		onAction {
		}
	}

	windowDef gameback {
		rect 0 ,0,640,480

		windowDef back1 {
			rect 0 ,0,640,480
			background "guis/assets/arcade/stars.tga"
			matscalex 2
			matscaley 2
			matcolor .5,.5,.5,.5
		}
		windowDef back1_1 {
			rect 100,100,440,280
			background "guis/assets/arcade/stars.tga"
			//backcolor 1,0,0,1

			matcolor .8,.8,.8,.2

			onTime 0 {
				transition "matcolor" ".8 .8 .8 .2" ".8 .8 .8 .5" "1000";
			}
			onTime 1000 {
				transition "matcolor" ".8 .8 .8 .5" ".8 .8 .8 .2" "1000";
			}
			onTime 2000 {
				resetTime "0";
			}
		}
		windowDef back2 {
			rect 320 ,0,640,480
			background "guis/assets/arcade/stars.tga"
			matscalex 2
			matscaley 2
			matcolor .5,.5,.5,.5
		}
		windowDef back1 {
			rect 0 ,240,640,480
			background "guis/assets/arcade/stars.tga"
			matscalex 2
			matscaley 2
			matcolor .5,.5,.5,.5
		}
		windowDef back2 {
			rect 320 ,240,640,480
			background "guis/assets/arcade/stars.tga"
			matscalex 2
			matscaley 2
			matcolor .5,.5,.5,.5
		}
	}

	//Function Windows

	/*
	* Fades the menu screen and begins the game
	*/
	windowDef fnStartGame {

		notime 1

		onTime 0 {
			set			"game::resetGame"	"1";
			set			"game::refreshGuiData" "1";
			transition	"IntroScreen::rect" "0 0 640 480" "0 -480 640 480" "1000";
			transition	"LevelIntroScreen::rect" "0 -480 640 480" "0 0 640 480" "1000";
			resetTime "LevelIntroScreen" "0";
		}

	}

	windowDef fnNextLevel {
		noTime 1

		onTime 0 {
			transition	"LevelCompleteScreen::rect" "0 0 640 480" "0 -480 640 480" "1000";
			transition	"LevelIntroScreen::rect" "0 -480 640 480" "0 0 640 480" "1000";
			resetTime	"LevelIntroScreen" "0";
		}
	}

	windowDef fnBeginLevel {
		noTime 1

		onTime 0 {
			"transition" "LevelIntroScreen::rect" "0 0 640 480" "0 -480 640 480" "1000";
			resetTime	"fnShowGame" "0";
		}
		onTime 1000 {
			set			"game::beginLevel"	"1";
		}
	}

	windowDef fnGameOver {

		notime 1

		onTime 0 {
			set				"GameOverScreen::visible" "1";
			resetTime		"fnHideGame" "0";


			transition		"GameOverScreen::rect" "0 -480 640 480" "0 0 640 480" "500";
			resetTime		"GameOverScreen" "0";
		}
	}

	windowDef fnIntroScreen {
		noTime 1

		onTime 0 {
			set "InsertCredit::visible" "1";
			set "StartButton::visible" "0";

			set			"desktop::credits" "0";

			resetTime	"fnHideGame" "0";

			set			"IntroScreen::visible"	"1";
			transition	"IntroScreen::rect" "0 -480 640 480" "0 0 640 480" "1000";
		}
	}

	windowDef fnShowGame {
		noTime 1
		onTime 0 {
			transition "game_main::matcolor" "1,1,1,0" "1,1,1,1" "1000";
			transition "game::matcolor" "1,1,1,0" "1,1,1,1" "1000";


		}
	}
	windowDef fnHideGame {
		noTime 1
		onTime 0 {
			transition "game_main::matcolor" "1,1,1,1" "1,1,1,0" "1000";
			transition "game::matcolor" "1,1,1,1" "1,1,1,0" "1000";
		}
	}

	windowDef fnContinueGame {
		noTime 1

		onTime 0 {
			set				"game::continueGame"	"1";


			resetTime		"fnShowGame"			"0";


			set				"GameOverScreen::noTime"	"1";
			//resetTime		"GameOverScreen"	"20000"; //Make sure we don't return to the main menu

			transition		"GameOverScreen::rect" "0 0 640 480" "0 -480 640 480" "100";
		}
	}

	windowDef fnLevelComplete {
		noTime 1

		onTime 0 {
			resetTime		"fnHideGame" "0";

			transition		"LevelCompleteScreen::rect" "0 -480 640 480" "0 0 640 480" "500";
			resetTime		"LevelCompleteScreen" "0";
		}
	}

	windowDef fnGameComplete {
		noTime 1

		onTime 0 {
			resetTime		"fnHideGame" "0";

			transition		"GameCompleteScreen::rect" "0 -480 640 480" "0 0 640 480" "500";
			resetTime		"GameCompleteScreen" "0";
		}
	}


	windowDef fnShackScreen {

		notime 1

		onTime 0 {
			transition "desktop::rect" "0 0 640 480" "-10 -5 640 480" "50";
		}
		onTime 50 {
			transition "desktop::rect" "-10 -5 640 480" "0 0 640 480" "50";
		}
		onTime 100 {
			transition "desktop::rect" "0 0 640 480" "10 10 640 480" "50";
		}
		onTime 150 {
			transition "desktop::rect" "10 10 640 480" "0 0 640 480" "50";
		}
	}

	windowDef fnShowGame {
		noTime 1
		onTime 0 {
			set "gameHUD::visible"		"1";
			set "scoreGroup::visible"	"1";
			set "HealthGroup::visible"	"1";
			set "LevelCompleteGroup::visible"	"1";
			set "TargetGroup::visible"	"1";
			set	"SuperBlaster::visible"	"0";
			set	"desktop::hideCursor" "1";
		}
	}
	windowDef fnHideGame {
		noTime 1
		onTime 0 {
			set "gameHUD::visible"		"0";
			set "scoreGroup::visible"	"0";
			set "HealthGroup::visible"	"0";
			set "LevelCompleteGroup::visible"	"0";
			set "TargetGroup::visible"	"0";
			set	"SuperBlaster::visible"	"0";
			set	"desktop::hideCursor" "0";
		}
	}

