	windowDef GameOverScreen {
		rect		0, -480,640,480
		//rect		0, 0,640,480
		visible		0

		noTime		1

		/*windowDef GameOverWin1 {

			rect	65,75,505,96
			visible	1
			background	"guis/assets/teleporter/button1"
			matcolor	0.6,0,0,1


			windowDef GameOverText
			{
				rect	0,10,505,96
				text	"Game Over"
				font	"fonts/bank"
				textscale	1
				forecolor	1,1,1,0.8
				visible	1
				textalign	1
			}
		}*/

		windowDef GameOverImage {
			rect 170,10,300,300
			background "game/SSD/gameover"
		}

		windowDef ContinueText {
			rect 0, 270, 640, 480
			text "1"
			textscale 2
			forecolor 1,1,1,1
			textalign	1
		}

		windowDef ContinueButtonImage {
			rect	170,380,300,80
			visible	1
			background "guis/assets/arcade/arcade_coincontinue_button.tga"
			matcolor	0.0,0.6,0,.6
		}

		windowDef ContinueButton {
			rect	170,400,300,60
			visible	1
			//background	"guis/assets/teleporter/button1"
			//matcolor	0.0,0.6,0,.6

			text		"#str_00100113"
			textalign	1
			textscale	.6
			forecolor   1,1,1,1

			onAction {
				set	"cmd"	"play arcade_startbeep" ;
				resetTime "fnContinueGame"	"0";
			}
		}

		onTime 0 {
			set "ContinueText::text" "10";
		}
		onTime 1000 {
			set "ContinueText::text" "9";
		}
		onTime 2000 {
			set "ContinueText::text" "8";
		}
		onTime 3000 {
			set "ContinueText::text" "7";
		}
		onTime 4000 {
			set "ContinueText::text" "6";
		}
		onTime 5000 {
			set "ContinueText::text" "5";
		}
		onTime 6000 {
			set "ContinueText::text" "4";
		}
		onTime 7000 {
			set "ContinueText::text" "3";
		}
		onTime 8000 {
			set "ContinueText::text" "2";
		}
		onTime 9000 {
			set "ContinueText::text" "1";
		}
		onTime 10000 {
			transition		"GameOverScreen::rect" "0 0 640 480" "0 -480 640 480" "500";
			set				"ContinueText::text" "0";
			resetTime		"fnIntroScreen" "0";
		}
	}


